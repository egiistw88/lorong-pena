# Wajib — TTS tidak akan berfungsi tanpa ini.
GEMINI_API_KEY=
# Opsional tapi SANGAT disarankan — cache persisten di Cloudflare R2 untuk
# audio TTS. Tanpa ini, cache TTS hanya hidup di memori server dan HILANG
# setiap kali server sleep/restart (lihat perilaku free tier Render) —
# artinya audio yang sama akan di-generate ulang lewat Gemini berkali-kali,
# menagih kuota/biaya berulang untuk konten yang persis sama.
# Kosongkan semua nilai di bawah untuk menonaktifkan cache R2 (server tetap
# berjalan normal, cuma tanpa penghematan lintas-restart).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lorong-pena-audio
